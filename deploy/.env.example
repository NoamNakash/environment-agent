# Copy to deploy/.env for local overrides (loaded by compose in this directory).

# --- Agent identity ---
# AGENT_NAME=local-agent
# AGENT_ENVIRONMENT=dev
# AGENT_COST=low
# AGENT_PORT=8081

# --- DCM integration ---
# Base URL only (agent registers at /api/v1alpha1/agents).
# Standalone stack default reaches control-plane on the host via host.docker.internal.
# DCM_REGISTRATION_URL=http://host.docker.internal:8080
# Agent-only (control-plane NATS on host): nats://host.docker.internal:4222
# With make compose-up-with-nats: nats://nats:4222
# AGENT_MESSAGING_URL=nats://host.docker.internal:4222

# --- Embedded service providers ---
# Service types: container, vm, cluster, storage, network (comma-separated).
# AGENT_EMBEDDED_SPS=container,vm,cluster,storage,network
# AGENT_SP_PERSISTENCE_PATH=/app/data/registrations.json   # compose default; writable by UID 1001
# Written by make kubeconfig-for-compose (API URL https://kubernetes:6443). Path relative to deploy/.
AGENT_KUBECONFIG_HOST=.kube/config
# SP_DEFAULT_KUBECONFIG is set to /kubeconfig in deploy/compose.yaml (in-container path).

# Container SP (when container is in AGENT_EMBEDDED_SPS)
# SP_CONTAINER_NAMESPACE=default   # if you change this, manually create the namespace on the cluster
# SP_K8S_EXTERNAL_SVC_TYPE=NodePort
# SP_MONITOR_DEBOUNCE_MS=500
# SP_MONITOR_RESYNC_PERIOD=10m

# VM SP (when vm is in AGENT_EMBEDDED_SPS, ensure to run make install-kubevirt before compose-up)
# SP_VM_NAMESPACE=default   # if you change this, manually create the namespace on the cluster
# KUBERNETES_TIMEOUT=60s
# KUBERNETES_MAX_RETRIES=3
# EVENTS_ENABLED=true
# EVENTS_RESYNC_PERIOD=30m

# Cluster SP (when cluster is in AGENT_EMBEDDED_SPS; OpenShift ACM/MCE, not Kind)
# SP_CLUSTER_NAMESPACE=clusters
# SP_BASE_DOMAIN=apps.example.com
# SP_PULL_SECRET=<base64-encoded-dockerconfigjson>
# SP_CONSOLE_URI_PATTERN=https://console-openshift-console.apps.{name}.{base_domain}
# SP_VERSION_MATRIX_PATH=/path/to/version-matrix.json
# SP_ENABLED_PLATFORMS=kubevirt,baremetal
# SP_HEALTH_CHECK_TIMEOUT=5s
# SP_STATUS_DEBOUNCE_INTERVAL=1s
# SP_STATUS_RESYNC_INTERVAL=10m
# SP_NATS_PUBLISH_RETRY_MAX=3
# SP_NATS_PUBLISH_RETRY_INTERVAL=2s
# BareMetal (Agent) platform only (not to be confused with DCM environment-agent):
# SP_DEFAULT_INFRA_ENV=my-infra-env
# SP_AGENT_NAMESPACE=my-agent-namespace  # ACM agent-install namespace (Agent CRs on management cluster)
# SP_INFRA_ENV_LABEL_KEY=infraenvs.agent-install.openshift.io

# Storage SP (when storage is in AGENT_EMBEDDED_SPS)
# SP_STORAGE_NAMESPACE=default   # if you change this, manually create the namespace on the cluster
# SP_K8S_DEFAULT_STORAGE_CLASS=
# SP_K8S_DEFAULT_ACCESS_MODE=ReadWriteOnce
# SP_MONITOR_DEBOUNCE_MS=500
# SP_MONITOR_RESYNC_PERIOD=10m
# SP_MONITOR_PUBLISH_MAX_ATTEMPTS=5

# Network SP (when network is in AGENT_EMBEDDED_SPS)
# SP_NETWORK_NAMESPACE=default   # if you change this, manually create the namespace on the cluster
# SP_MONITOR_DEBOUNCE_MS=500
# SP_MONITOR_RESYNC_PERIOD=10m
# SP_MONITOR_PUBLISH_MAX_ATTEMPTS=5

# --- Image version (pin a release tag for production) ---
# ENVIRONMENT_AGENT_VERSION=main
